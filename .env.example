# TaskFlow — Environment Variables Configuration

# Server Port
PORT=5000

# Client Port (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Optional: connects to local or Atlas MongoDB, or uses embedded fallback if unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JWT Secret Key
JWT_SECRET=taskflow-super-secret-key-2026-production

# Node Environment
NODE_ENV=development
